# Copy to .env.local. Every integration below is off until its vars are set.

# Public URL, used for referral links, OG tags, sitemap
NEXT_PUBLIC_SITE_URL=https://greenmart.ng

# Database. Unset = dev JSON file in .data/. Create the table with `npm run db:migrate`.
DATABASE_URL=mysql://user:pass@host:3306/greenmart_waitlist

# Anti-spam: Cloudflare Turnstile (widget shows only when both are set)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for hashed IPs used by the rate limit (any long random string)
IP_HASH_SALT=

# Welcome email via Resend
RESEND_API_KEY=
RESEND_FROM="GreenMart <hello@greenmart.ng>"
# Welcome WhatsApp via Termii (also needs WHATSAPP_ENABLED=1)
TERMII_API_KEY=
TERMII_SENDER_ID=
WHATSAPP_ENABLED=0

# /admin password
ADMIN_PASSWORD=

# Analytics (either or both)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
